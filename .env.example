# Required for live briefings. Create one at https://app.tavily.com
# Hackathon coupon (no card): GEEKROOM2 — redeem in the Tavily dashboard.
TAVILY_API_KEY=

# Optional. If neither key is set, MeetBrief still writes a briefing from
# Tavily sources using a structured template (no invented claims).
# When both are set, Groq is used first.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides.
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
